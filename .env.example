# ============================================================
# NutriCoach — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# Application
NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL) ────────────────────────────────────
DB_HOST=192.168.1.13
DB_PORT=5432
DB_USER=nutricoach
DB_PASSWORD=CHANGE_ME
DB_NAME=nutricoach_db

# ── Redis ────────────────────────────────────────────────────
# Format: redis://[password@]host:port
REDIS_URL=redis://192.168.1.13:6379

# ── JWT ──────────────────────────────────────────────────────
# Generate both values independently:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# They MUST be different strings.
JWT_SECRET=CHANGE_ME_generate_with_crypto_randomBytes_32
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_different_from_JWT_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-placeholder

# ── PayOS ────────────────────────────────────────────────────
PAYOS_CLIENT_ID=placeholder
PAYOS_API_KEY=placeholder
PAYOS_CHECKSUM_KEY=placeholder

# ── Storage ──────────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# AWS S3 / Cloudflare R2 (only needed when STORAGE_TYPE=s3 or r2)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET_NAME=

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug
